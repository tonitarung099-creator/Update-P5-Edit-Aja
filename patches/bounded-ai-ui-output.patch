 namespace {
+QString boundedUiPlainText(const QString &text, qsizetype maxChars)
+{
+    if (text.size() <= maxChars) {
+        return text;
+    }
+    return text.left(maxChars) + QStringLiteral(" … [display truncated]");
+}
+
+QString boundedTraceHtml(const QString &html)
+{
+    constexpr qsizetype maxTraceChars = 32768;
+    if (html.size() <= maxTraceChars) {
+        return html;
+    }
+
+    // Trace strings are trusted UI markup around escaped payloads. For a very
+    // large entry, parse only the bounded prefix and flatten it to escaped text
+    // so truncation cannot leave an unterminated tag/entity or create markup.
+    QTextDocument prefixDocument;
+    prefixDocument.setHtml(html.left(maxTraceChars));
+    const QString plainPrefix = prefixDocument.toPlainText();
+    return QStringLiteral("%1<br><i>%2</i>")
+        .arg(plainPrefix.toHtmlEscaped(), i18n("Display truncated to keep the AI sidebar responsive."));
+}
