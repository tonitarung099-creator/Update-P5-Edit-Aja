+void MainWindow::applyCreatorLayout()
+{
+    if (!m_projectBinDock || !m_projectMonitorDock || !m_effectStackDock || !m_timelineDock) {
+        return;
+    }
+
+    const QSize dockWindowSize = mainDockWindow->size();
+    const QSize timelineSize(0, qMax(270, dockWindowSize.height() * 45 / 100));
+    const QSize binSize(qMax(270, dockWindowSize.width() * 22 / 100), qMax(320, dockWindowSize.height() * 53 / 100));
+    const QSize sidebarSize(qMax(350, dockWindowSize.width() * 28 / 100), qMax(320, dockWindowSize.height() * 53 / 100));
+
+    if (m_clipMonitorDock) {
+        m_clipMonitorDock->close();
+    }
+    if (m_mixerDock) {
+        m_mixerDock->close();
+    }
+
+    m_projectBinDock->open();
+    m_projectMonitorDock->open();
+    m_timelineDock->open();
+    m_effectStackDock->open();
+
+    mainDockWindow->addDockWidget(m_timelineDock, KDDockWidgets::Location_OnBottom, nullptr, timelineSize);
+    mainDockWindow->addDockWidget(m_projectBinDock, KDDockWidgets::Location_OnLeft, m_projectMonitorDock, binSize);
+    mainDockWindow->addDockWidget(m_effectStackDock, KDDockWidgets::Location_OnRight, m_projectMonitorDock, sidebarSize);
+    m_projectMonitorDock->setAsCurrentTab();
+
+    if (m_aiAssistantDock) {
+        auto *rightGroup = m_effectStackDock->asGroupController();
+        if (!rightGroup || !rightGroup->containsDockWidget(m_aiAssistantDock->asDockWidgetController())) {
+            m_effectStackDock->addDockWidgetAsTab(m_aiAssistantDock);
+        }
+        m_aiAssistantDock->open();
+        m_aiAssistantDock->setAsCurrentTab();
+    }
+
+    QSettings editAjaSettings;
+    editAjaSettings.setValue(QStringLiteral("editaja/creatorLayoutVersion"), 2);
+}
