+QJsonObject AgentToolRegistry::invoke(const QString &name, const QJsonObject &arguments) const
+{
+    const Tool *tool = findTool(name);
+    if (!tool) {
+        return QJsonObject{{QStringLiteral("ok"), false}, {QStringLiteral("error"), QStringLiteral("Unknown tool: %1").arg(name)}};
+    }
+    if (tool->asyncHandler) {
+        return QJsonObject{{QStringLiteral("ok"), false},
+                           {QStringLiteral("async"), true},
+                           {QStringLiteral("error"), QStringLiteral("Tool requires asynchronous invocation")}};
+    }
+    if (!tool->handler) {
+        return QJsonObject{{QStringLiteral("ok"), false}, {QStringLiteral("error"), QStringLiteral("Tool has no handler")}};
+    }
+    return tool->handler(arguments);
+}
+
+QJsonObject AgentToolRegistry::invokeOrStart(const QString &name, const QJsonObject &arguments)
+{
+    const Tool *tool = findTool(name);
+    if (!tool) {
+        return QJsonObject{{QStringLiteral("ok"), false}, {QStringLiteral("error"), QStringLiteral("Unknown tool: %1").arg(name)}};
+    }
+    if (!tool->asyncHandler) {
+        return invoke(name, arguments);
+    }
+
+    const QString jobId = QUuid::createUuid().toString(QUuid::WithoutBraces);
+    m_jobs.insert(jobId, Job{QStringLiteral("running"), {}, {}});
+    m_jobOrder.push_back(jobId);
+
+    CancelHandler cancel = tool->asyncHandler(arguments, [this, jobId](const QJsonObject &result) { completeJob(jobId, result); });
+    auto job = m_jobs.find(jobId);
+    if (job != m_jobs.end() && job->status == QLatin1String("running")) {
+        job->cancel = std::move(cancel);
+    }
+    pruneJobs();
+    return QJsonObject{{QStringLiteral("ok"), true},
+                       {QStringLiteral("async"), true},
+                       {QStringLiteral("job_id"), jobId},
+                       {QStringLiteral("status"), QStringLiteral("running")}};
+}
+
+QJsonObject AgentToolRegistry::jobStatus(const QString &jobId) const
+{
+    const auto job = m_jobs.constFind(jobId);
+    if (job == m_jobs.cend()) {
+        return QJsonObject{{QStringLiteral("ok"), false}, {QStringLiteral("error"), QStringLiteral("Unknown tool job: %1").arg(jobId)}};
+    }
+    QJsonObject response{{QStringLiteral("ok"), true},
+                         {QStringLiteral("async"), true},
+                         {QStringLiteral("job_id"), jobId},
+                         {QStringLiteral("status"), job->status}};
+    if (job->status != QLatin1String("running")) {
+        response.insert(QStringLiteral("result"), job->result);
+    }
+    return response;
+}
+
+QJsonObject AgentToolRegistry::cancelJob(const QString &jobId)
+{
+    auto job = m_jobs.find(jobId);
+    if (job == m_jobs.end()) {
+        return QJsonObject{{QStringLiteral("ok"), false}, {QStringLiteral("error"), QStringLiteral("Unknown tool job: %1").arg(jobId)}};
+    }
+    if (job->status != QLatin1String("running")) {
+        return jobStatus(jobId);
+    }
+
+    CancelHandler cancel = std::move(job->cancel);
+    job->status = QStringLiteral("cancelled");
+    job->result = QJsonObject{{QStringLiteral("ok"), false}, {QStringLiteral("error"), QStringLiteral("Tool job cancelled.")}};
+    if (cancel) {
+        cancel();
+    }
+    Q_EMIT jobFinished(jobId, job->result);
+    pruneJobs();
+    return jobStatus(jobId);
+}
+
+void AgentToolRegistry::completeJob(const QString &jobId, const QJsonObject &result)
+{
+    auto job = m_jobs.find(jobId);
+    if (job == m_jobs.end() || job->status != QLatin1String("running")) {
+        return;
+    }
+    job->status = QStringLiteral("completed");
+    job->result = result;
+    job->cancel = {};
+    Q_EMIT jobFinished(jobId, result);
+    pruneJobs();
+}
