 void MainWindow::finishUiSetup()
 {
+    QSettings editAjaSettings;
+    constexpr int creatorLayoutVersion = 1;
+    const int savedCreatorLayoutVersion = editAjaSettings.value(QStringLiteral("editaja/creatorLayoutVersion"), 0).toInt();
+
     pCore->restoreLayout();
 
+    // Migrate once to the Edit Aja creator layout: Media on the left, one large
+    // project viewer in the center, AI/properties on the right, and a full-width
+    // timeline below. After migration the normal saved layout remains user-owned.
+    if (savedCreatorLayoutVersion < creatorLayoutVersion && m_projectBinDock && m_projectMonitorDock && m_effectStackDock && m_timelineDock) {
+        const QSize dockWindowSize = mainDockWindow->size();
+        const QSize timelineSize(0, qMax(260, dockWindowSize.height() * 44 / 100));
+        const QSize binSize(qMax(280, dockWindowSize.width() * 23 / 100), qMax(320, dockWindowSize.height() * 54 / 100));
+        const QSize sidebarSize(qMax(340, dockWindowSize.width() * 26 / 100), qMax(320, dockWindowSize.height() * 54 / 100));
+
+        if (m_clipMonitorDock) {
+            m_clipMonitorDock->close();
+        }
+        if (m_mixerDock) {
+            m_mixerDock->close();
+        }
+
+        m_projectBinDock->open();
+        m_projectMonitorDock->open();
+        m_timelineDock->open();
+        m_effectStackDock->open();
+
+        // Re-dock existing widgets rather than recreating them, preserving every
+        // native Kdenlive controller and signal connection.
+        mainDockWindow->addDockWidget(m_timelineDock, KDDockWidgets::Location_OnBottom, nullptr, timelineSize);
+        mainDockWindow->addDockWidget(m_projectBinDock, KDDockWidgets::Location_OnLeft, m_projectMonitorDock, binSize);
+        mainDockWindow->addDockWidget(m_effectStackDock, KDDockWidgets::Location_OnRight, m_projectMonitorDock, sidebarSize);
+        m_projectMonitorDock->setAsCurrentTab();
+
+        editAjaSettings.setValue(QStringLiteral("editaja/creatorLayoutVersion"), creatorLayoutVersion);
+    }
+
