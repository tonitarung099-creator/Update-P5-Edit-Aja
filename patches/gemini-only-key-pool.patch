 void OpenAiCompatibleAgent::handleReply(QNetworkReply *reply)
 {
     const QByteArray bytes = reply->readAll();
+    const int httpStatus = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
     if (reply->error() != QNetworkReply::NoError) {
+        auto pool = s_geminiPools.find(this);
+        const int apiKeyIndex = reply->property("p5GeminiApiKeyIndex").toInt();
+        if (pool != s_geminiPools.end() && apiKeyIndex >= 0 && apiKeyIndex < pool->keys.size()) {
+            const QByteArray lower = bytes.toLower();
+            const bool rateLimited = httpStatus == 429 || lower.contains("resource_exhausted") || lower.contains("rate limit");
+            const bool invalidKey = httpStatus == 401 || httpStatus == 403 || lower.contains("api_key_invalid") || lower.contains("api key not valid");
+            if (rateLimited || invalidKey) {
+                pool->attemptedThisTurn.insert(apiKeyIndex);
+                if (invalidKey) {
+                    pool->disabledIndices.insert(apiKeyIndex);
+                    Q_EMIT trace(QStringLiteral("Gemini API key #%1 was rejected and is disabled for this session. Trying another key.").arg(apiKeyIndex + 1));
+                } else {
+                    bool retryAfterOk = false;
+                    int retryAfterSeconds = reply->rawHeader("Retry-After").trimmed().toInt(&retryAfterOk);
+                    if (!retryAfterOk || retryAfterSeconds <= 0) {
+                        retryAfterSeconds = 60;
+                    }
+                    if (apiKeyIndex < pool->cooldownUntilMs.size()) {
+                        pool->cooldownUntilMs[apiKeyIndex] = QDateTime::currentMSecsSinceEpoch() + qint64(retryAfterSeconds) * 1000;
+                    }
+                    Q_EMIT trace(QStringLiteral("Gemini API key #%1 hit a quota/rate limit. Cooling it down and switching automatically.").arg(apiKeyIndex + 1));
+                }
+
+                if (pool->keys.size() > 1) {
+                    pool->activeIndex = (apiKeyIndex + 1) % pool->keys.size();
+                }
+                if (selectGeminiApiKey(*pool) >= 0) {
+                    pool->retryingApiKey = true;
+                    sendTurn();
+                    return;
+                }
+                fail(rateLimited
+                         ? QStringLiteral("All configured Gemini API keys are currently rate-limited or cooling down. Try again after the quota window resets.")
+                         : QStringLiteral("All configured Gemini API keys were rejected. Check the keys in Gemini API settings."));
+                return;
+            }
+        }
         fail(QStringLiteral("API error: %1\n%2").arg(reply->errorString(), QString::fromUtf8(bytes.left(4000))));
         return;
     }
