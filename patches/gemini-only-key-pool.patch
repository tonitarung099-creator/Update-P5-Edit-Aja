 #include <QUrl>
+
+namespace {
+constexpr auto kGeminiChatCompletionsUrl = "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions";
+
+struct GeminiApiPoolState
+{
+    QStringList keys;
+    QSet<int> disabledIndices;
+    QSet<int> attemptedThisTurn;
+    QVector<qint64> cooldownUntilMs;
+    int activeIndex{0};
+    bool retryingApiKey{false};
+};
+
+QHash<const OpenAiCompatibleAgent *, GeminiApiPoolState> s_geminiPools;
+
+bool isGeminiEndpoint(const QString &url)
+{
+    const QString normalized = url.trimmed();
+    if (normalized.compare(QLatin1String(kGeminiChatCompletionsUrl), Qt::CaseInsensitive) == 0) {
+        return true;
+    }
+    const QByteArray testOverride = qgetenv("P5_GEMINI_API_ENDPOINT_OVERRIDE");
+    return !testOverride.isEmpty() && normalized == QString::fromUtf8(testOverride).trimmed();
+}
+
+QStringList sanitizeGeminiApiKeys(const QString &raw)
+{
+    QStringList keys;
+    QSet<QString> seen;
+    const QStringList lines = raw.split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+    for (const QString &line : lines) {
+        const QString key = line.trimmed();
+        if (key.isEmpty() || seen.contains(key)) {
+            continue;
+        }
+        seen.insert(key);
+        keys.push_back(key);
+        if (keys.size() >= 100) {
+            break;
+        }
+    }
+    return keys;
+}
+
+void configureGeminiPool(const OpenAiCompatibleAgent *agent, const QStringList &keys)
+{
+    auto &state = s_geminiPools[agent];
+    if (state.keys == keys) {
+        return;
+    }
+    state.keys = keys;
+    state.disabledIndices.clear();
+    state.attemptedThisTurn.clear();
+    state.cooldownUntilMs = QVector<qint64>(keys.size(), 0);
+    state.activeIndex = 0;
+    state.retryingApiKey = false;
+}
+
+int selectGeminiApiKey(const GeminiApiPoolState &state)
+{
+    if (state.keys.isEmpty()) {
+        return -1;
+    }
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    for (int offset = 0; offset < state.keys.size(); ++offset) {
+        const int index = (state.activeIndex + offset) % state.keys.size();
+        if (state.disabledIndices.contains(index) || state.attemptedThisTurn.contains(index)) {
+            continue;
+        }
+        if (index < state.cooldownUntilMs.size() && state.cooldownUntilMs.at(index) > now) {
+            continue;
+        }
+        return index;
+    }
+    return -1;
+}
+}
 
