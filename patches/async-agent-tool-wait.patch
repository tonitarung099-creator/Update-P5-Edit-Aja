+void OpenAiCompatibleAgent::processNextToolCall()
+{
+    if (!m_registry) {
+        fail(QStringLiteral("Agent tool registry is unavailable."));
+        return;
+    }
+    if (m_pendingToolIndex >= m_pendingToolCalls.size()) {
+        clearPendingToolState();
+        sendTurn();
+        return;
+    }
+
+    const QJsonObject call = m_pendingToolCalls.at(m_pendingToolIndex).toObject();
+    const QJsonObject function = call.value(QStringLiteral("function")).toObject();
+    const QString name = function.value(QStringLiteral("name")).toString();
+    const QByteArray rawArgs = function.value(QStringLiteral("arguments")).toString().toUtf8();
+    QJsonObject arguments;
+    if (!rawArgs.isEmpty()) {
+        const QJsonDocument argsDoc = QJsonDocument::fromJson(rawArgs);
+        if (argsDoc.isObject()) {
+            arguments = argsDoc.object();
+        }
+    }
+
+    Q_EMIT trace(QStringLiteral("Tool: %1").arg(name));
+    if (!m_registry->isAsyncTool(name)) {
+        appendToolResult(call, m_registry->invoke(name, arguments));
+        ++m_pendingToolIndex;
+        processNextToolCall();
+        return;
+    }
+
+    const QJsonObject started = m_registry->invokeOrStart(name, arguments);
+    if (!started.value(QStringLiteral("async")).toBool()) {
+        appendToolResult(call, started);
+        ++m_pendingToolIndex;
+        processNextToolCall();
+        return;
+    }
+
+    m_toolJobId = started.value(QStringLiteral("job_id")).toString();
+    if (m_toolJobId.isEmpty()) {
+        appendToolResult(call, QJsonObject{{QStringLiteral("ok"), false}, {QStringLiteral("error"), QStringLiteral("Async tool did not return a job id.")}});
+        ++m_pendingToolIndex;
+        processNextToolCall();
+        return;
+    }
+
+    // A deterministic test handler may complete synchronously before jobFinished
+    // can be matched to m_toolJobId. Read the retained terminal result once.
+    const QJsonObject status = m_registry->jobStatus(m_toolJobId);
+    if (status.value(QStringLiteral("status")).toString() != QLatin1String("running")) {
+        m_toolJobId.clear();
+        appendToolResult(call, status.value(QStringLiteral("result")).toObject());
+        ++m_pendingToolIndex;
+        processNextToolCall();
+    }
+}
+
+void OpenAiCompatibleAgent::appendToolResult(const QJsonObject &call, const QJsonObject &result)
+{
+    const QString callId = call.value(QStringLiteral("id")).toString();
+    const QString resultText = QString::fromUtf8(QJsonDocument(result).toJson(QJsonDocument::Compact));
+    m_messages.push_back(QJsonObject{{QStringLiteral("role"), QStringLiteral("tool")},
+                                     {QStringLiteral("tool_call_id"), callId},
+                                     {QStringLiteral("content"), resultText}});
+
+    if (m_attachToolImages) {
+        QStringList imagePaths;
+        const QString singlePath = result.value(QStringLiteral("agent_image_path")).toString();
+        if (!singlePath.isEmpty()) {
+            imagePaths << singlePath;
+        }
+        for (const auto &pathValue : result.value(QStringLiteral("agent_image_paths")).toArray()) {
+            const QString path = pathValue.toString();
+            if (!path.isEmpty() && !imagePaths.contains(path)) {
+                imagePaths << path;
+            }
+            if (imagePaths.size() >= 6) {
+                break;
+            }
+        }
+        QJsonArray content;
+        for (const QString &imagePath : imagePaths) {
+            QFile imageFile(imagePath);
+            if (!imageFile.exists() || imageFile.size() > 12 * 1024 * 1024 || !imageFile.open(QIODevice::ReadOnly)) {
+                continue;
+            }
+            const QByteArray imageBytes = imageFile.readAll();
+            const QString suffix = QFileInfo(imagePath).suffix().toLower();
+            const QString mime = suffix == QLatin1String("jpg") || suffix == QLatin1String("jpeg") ? QStringLiteral("image/jpeg")
+                                                                                                  : QStringLiteral("image/png");
+            const QString dataUrl = QStringLiteral("data:%1;base64,%2").arg(mime, QString::fromLatin1(imageBytes.toBase64()));
+            content.push_back(QJsonObject{{QStringLiteral("type"), QStringLiteral("image_url")},
+                                          {QStringLiteral("image_url"), QJsonObject{{QStringLiteral("url"), dataUrl}}}});
+            Q_EMIT trace(QStringLiteral("Attached selected frame to vision-capable API model: %1").arg(imagePath));
+        }
+        if (!content.isEmpty()) {
+            content.prepend(QJsonObject{{QStringLiteral("type"), QStringLiteral("text")},
+                                        {QStringLiteral("text"), QStringLiteral("Selected local frames for visual inspection; these are not the whole movie.")}});
+            m_messages.push_back(QJsonObject{{QStringLiteral("role"), QStringLiteral("user")}, {QStringLiteral("content"), content}});
+        }
+    }
+    Q_EMIT trace(QStringLiteral("Result: %1").arg(resultText));
+}
+
+void OpenAiCompatibleAgent::clearPendingToolState()
+{
+    m_toolJobId.clear();
+    m_pendingToolCalls = {};
+    m_pendingToolIndex = 0;
+}
+
 void OpenAiCompatibleAgent::fail(const QString &message)
 {
+    clearPendingToolState();
     Q_EMIT busyChanged(false);
     Q_EMIT failed(message);
 }
