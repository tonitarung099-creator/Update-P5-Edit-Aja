 namespace {
+QString boundedPlainDisplayText(const QString &text, int maxCharacters)
+{
+    const QString simplified = text.trimmed();
+    if (simplified.size() <= maxCharacters) {
+        return simplified;
+    }
+    return simplified.left(maxCharacters) + QStringLiteral("… [display truncated]");
+}
+
+QString boundedDisplayHtml(const QString &html, int maxCharacters)
+{
+    if (html.size() <= maxCharacters) {
+        return html;
+    }
+    QTextDocument document;
+    document.setHtml(html);
+    const QString plain = boundedPlainDisplayText(document.toPlainText(), maxCharacters);
+    return plain.toHtmlEscaped() + QStringLiteral("<br><i>[display truncated; full tool data is preserved for the agent]</i>");
+}
