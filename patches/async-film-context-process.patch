 namespace {
+void stopOwnedProcessTree(QProcess *process)
+{
+    if (!process || process->state() == QProcess::NotRunning) {
+        return;
+    }
+    const qint64 pid = process->processId();
+#ifdef Q_OS_WIN
+    if (pid > 0) {
+        QProcess::startDetached(QStringLiteral("taskkill"),
+                                QStringList{QStringLiteral("/PID"), QString::number(pid), QStringLiteral("/T"), QStringLiteral("/F")});
+    }
+#else
+    // Best-effort child cleanup for non-Windows developer/test hosts. The Windows
+    // product build uses taskkill /T for the owned Python/FFmpeg process tree.
+    if (pid > 0) {
+        QProcess::startDetached(QStringLiteral("pkill"), QStringList{QStringLiteral("-TERM"), QStringLiteral("-P"), QString::number(pid)});
+    }
+#endif
+    process->kill();
+}
