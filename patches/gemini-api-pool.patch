 #include <QUrl>
 
+namespace {
+QStringList geminiKeyPool(const QString &serialized)
+{
+    QStringList keys;
+    const QStringList candidates = serialized.split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+    for (const QString &candidate : candidates) {
+        const QString key = candidate.trimmed();
+        if (!key.isEmpty() && !keys.contains(key)) {
+            keys.push_back(key);
+            if (keys.size() == 100) {
+                break;
+            }
+        }
+    }
+    return keys;
+}
+
+QSet<int> invalidGeminiKeyIndexes(const QObject *agent)
+{
+    QSet<int> result;
+    const QStringList parts = agent->property("p5GeminiInvalidKeys").toString().split(QLatin1Char(','), Qt::SkipEmptyParts);
+    for (const QString &part : parts) {
+        bool ok = false;
+        const int index = part.toInt(&ok);
+        if (ok) {
+            result.insert(index);
+        }
+    }
+    return result;
+}
+
+void storeInvalidGeminiKeyIndexes(QObject *agent, const QSet<int> &indexes)
+{
+    QStringList parts;
+    for (int index : indexes) {
+        parts.push_back(QString::number(index));
+    }
+    agent->setProperty("p5GeminiInvalidKeys", parts.join(QLatin1Char(',')));
+}
+
+int nextAvailableGeminiKey(const QObject *agent, int startAfter, int keyCount)
+{
+    if (keyCount <= 0) {
+        return -1;
+    }
+    const QSet<int> invalid = invalidGeminiKeyIndexes(agent);
+    const QVariantMap cooldowns = agent->property("p5GeminiCooldowns").toMap();
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    for (int offset = 1; offset <= keyCount; ++offset) {
+        const int index = (startAfter + offset + keyCount) % keyCount;
+        if (invalid.contains(index)) {
+            continue;
+        }
+        if (cooldowns.value(QString::number(index)).toLongLong() > now) {
+            continue;
+        }
+        return index;
+    }
+    return -1;
+}
+
+int geminiRetryDelaySeconds(QNetworkReply *reply, const QByteArray &body)
+{
+    bool ok = false;
+    const int headerSeconds = reply->rawHeader("Retry-After").trimmed().toInt(&ok);
+    if (ok && headerSeconds > 0) {
+        return qBound(5, headerSeconds, 24 * 60 * 60);
+    }
+    const QRegularExpression retryExpression(QStringLiteral("retry(?:Delay|_delay)[^0-9]{0,20}([0-9]+(?:\\.[0-9]+)?)s"), QRegularExpression::CaseInsensitiveOption);
+    const auto match = retryExpression.match(QString::fromUtf8(body));
+    if (match.hasMatch()) {
+        const int seconds = qCeil(match.captured(1).toDouble());
+        if (seconds > 0) {
+            return qBound(5, seconds, 24 * 60 * 60);
+        }
+    }
+    return 60;
+}
+}
