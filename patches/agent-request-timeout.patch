+void OpenAiCompatibleAgent::handleRequestTimeout()
+{
+    QNetworkReply *reply = m_reply.data();
+    if (!reply) {
+        return;
+    }
+
+    // Detach before abort() because finished may be emitted synchronously.
+    // The stale callback will only delete the old reply and cannot report a
+    // second failure or alter a later request.
+    m_reply.clear();
+    reply->abort();
+    fail(QStringLiteral("API request timed out after %1 seconds. You can increase the timeout in API settings for slower local models.")
+             .arg(m_requestTimeoutMs / 1000.0, 0, 'f', 1));
